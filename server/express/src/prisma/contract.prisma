// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  todos     Todo[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Todo {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean  @default(false)
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}