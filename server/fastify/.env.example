# Copy this file to `.env` and replace the placeholders with real values.
# The committed `.env` is dotenvx-encrypted; `.env.keys` holds the decryption key.

# Connection string for PostgreSQL (>= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign auth tokens. Generate one, e.g. `openssl rand -hex 32`.
# If unset, a random per-process secret is used and tokens die on restart.
TOKEN_SECRET="change-me-to-a-long-random-string"

# Auth token lifetime in seconds (default: 7 days).
TOKEN_TTL_SECONDS=604800

# Allowed CORS origin (default: *). Set to the web app origin in production.
CORS_ORIGIN="*"

# HTTP port (default: 3001, so it can run beside the Express sibling on 3000)
# and bind host (default: 0.0.0.0).
PORT=3001
HOST="0.0.0.0"

# Fastify log level (default: info). Logger is disabled when NODE_ENV=test.
LOG_LEVEL="info"